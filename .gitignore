dist/
build/
*.tsbuildinfo

# Go
services/judge-go/bin/
# `go build ./...` main paket uchun binary'ni shu yerga yozadi. U avval
# git'da turardi (11.8 MB) — har build'da o'zgarib, ishchi daraxtni
# iflos qilardi. Dockerfile o'zi quradi, ya'ni artefakt kerak emas.
/services/judge-go/judge-go

# Data / local
data/
*.sqlite3
media/
staticfiles/

# IDE / OS
.DS_Store
.idea/
.vscode/

# Agent ish daraxtlari. `.claude/worktrees/` — `git worktree` nusxalari, ya'ni
# repo'ning TO'LIQ ko'chirmasi (o'z `tools/`, `apps/` bilan). Kuzatilsa
# tasodifan commit qilinishi mumkin edi; `tools/check_docs.py` ham ularni
# skanerlab, o'sha nusxadagi misol matnlarni haqiqiy xato deb o'qirdi.
.claude/

# Bake-off natijalari (mahalliy o'lchov)
services/bakeoff/result-*-scratch.md

# Django
apps/api/db.sqlite3
apps/api/staticfiles/
# uv writes this lock on every `uv run`. Nothing installs from it (the image
# uses requirements.lock), and while it was tracked every run showed up as a
# change. The interpreter is pinned by apps/api/.python-version instead.
apps/api/uv.lock
apps/web/.next/
apps/web/node_modules/

# Playwright
tests/e2e/test-results/
tests/e2e/playwright-report/

# Public preview uchun yaratilgan admin paroli
.admin-password.txt

# Ikki tizimli preview (tools/handoff.*): eksport nusxalari, tunnel PID va logi
.handoff/

# Changelog sinxronizatsiya nuqtasi (tools/sync_updates.py) — har ish joyi o'ziniki
tools/.update-sync.json

# Agent xotirasi (loyihaga bog'liq emas, har ish joyi o'ziniki)
.workbuddy-ai/

# Mahalliy tahlil skriptlari: i18n skaneri, kalit qo'shuvchilar, o'lchov
# natijalari. Bir martalik ish qurollari — repoga tushmasin.
.tmp/

# Domen/brend nomi tanlash tahlili (2026-09-14). Bir martalik ish quroli:
# skriptlar, nomzodlar ro'yxati va hisobotlar. Mahsulot kodi emas.
tools/naming/

# Python paket metadatasi. `pip install -e .` da AVTOMATIK qayta yoziladi —
# kuzatilsa, har o'rnatishdan keyin "o'zgargan" shovqin beradi
# (o'lchandi: `pyproject.toml` dagi `ruff==0.16.6` shu fayllarga ko'chgan).
*.egg-info/

# CI/CD sessiya jurnali (real vaqtda kuzatuv uchun)
ci-cd.log
