{
  "id": "01-aplusb",
  "title": "A+B — bazaviy oqim",
  "measures": "start latency, to'g'ri AC",
  "language": {
    "code": "cpp23",
    "compile": [
      "g++",
      "-std=c++23",
      "-O2",
      "-o",
      "{bin}",
      "{src}"
    ],
    "run": [
      "{bin}"
    ]
  },
  "source": "#include <bits/stdc++.h>\nint main(){long long a,b;std::cin>>a>>b;std::cout<<a+b<<\"\\n\";}\n",
  "limits": {
    "compile_time_ms": 10000,
    "time_ms": 1000,
    "memory_kb": 262144,
    "output_kb": 65536,
    "processes": 1
  },
  "tests": [
    {
      "index": 1,
      "input": "1 2\n",
      "expected": "3\n"
    },
    {
      "index": 2,
      "input": "-5 5\n",
      "expected": "0\n"
    }
  ],
  "expect_verdict": "AC",
  "must_hold": [
    "time_ms < 200",
    "memory_kb > 0",
    "judge_meta.sandbox_setup_ms mavjud"
  ],
  "mode": "acm"
}
