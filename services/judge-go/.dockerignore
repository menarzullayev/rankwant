# Build konteksti — bu fayl Docker'ga nima YUBORILMASLIGINI aytadi.
#
# Nega kerak: kesh qatlami kontekst fayllarining mazmuniga bog'lanadi.
# Keraksiz fayl o'zgarsa (masalan lokal `go build` chiqishi), qatlam
# bekor bo'ladi va `go mod download` qaytadan ishlaydi — holbuki
# `go.mod` o'zgarmagan.
#
# O'lchandi: repodagi `judge-go` binary'si 11.4 MB, u kontekstga
# tushardi va har qurilgandan keyin yangilanardi (self-hosted CI shu
# katalogda ishlaydi), ya'ni qatlamlarni behuda yangilardi.

# Lokal qurilgan binary — image ichida `go build` qiladi, bu kerak emas.
judge-go
bin/

# CGO/kompilyatsiya chiqindilari.
*.o
*.a
*.so

# Git tarixi — `git clone` qilinmaydi, faqat kontekst nusxasi.
.git/
.gitignore

# Mahalliy ishlab chiqish artefaktlari.
*.log
*.tmp
.DS_Store
