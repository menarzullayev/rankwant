# RankWant — template for `.env.public` (the file itself is git-ignored).
#
#   cp .env.example .env.public      # then fill in the empty values
#   docker compose -p rankwant --env-file .env.public \
#     -f docker-compose.yml -f docker-compose.public.yml up -d --build --wait
#
# Only variables that the compose files interpolate (`${VAR}`) reach the
# containers. Lines kept as comments further down are read by the code but
# are either set by compose itself or not passed at all — writing them into
# .env.public changes nothing until compose passes them.
#
# Keep secret values out of this file. tools/check_env_example.py fails CI when
# the code or compose reads a variable that is not documented here, when a
# required variable is missing, or when a secret-looking key has a value.

# ── Required by docker-compose.public.yml ───────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=rankwant.uz
PUBLIC_ORIGIN=https://rankwant.uz

# Email chain (core.mailer): the first provider that has a key sends.
EMAIL_CHAIN=brevo,mailjet,resend,mailersend
EMAIL_FROM=no-reply@rankwant.uz
EMAIL_FROM_NAME=RankWant
BREVO_API_KEY=
BREVO_FROM=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM=
RESEND_API_KEY=
RESEND_FROM=
MAILERSEND_API_KEY=
MAILERSEND_FROM=

# Social login and the Telegram bot.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# ── Compose defaults you may override ───────────────────────────────────
# NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1   # base compose only; public derives it from PUBLIC_ORIGIN
# REDIS_PORT=6379                                     # host port in the base compose
# GIT_SHA=unknown                                     # image label; tools/deploy.sh sets it
# BUILT_AT=unknown                                    # build timestamp label on the same images
# COMPOSE_PROJECT_NAME=rankwant                       # Compose project prefix; CI sets rw-<job>-<run_id>
# HOST_REPO_ROOT=                                     # CI bind mount source, daemon-side path. The containerized
#                                                     # runner derives and exports it (tools/runner/entrypoint.sh);
#                                                     # leave it unset by hand — the workflows fall back to $PWD.

# ── Set by compose itself (internal network, not from .env.public) ──────
# DATABASE_URL=postgres://rankwant:dev@postgres:5432/rankwant
# REDIS_URL=redis://redis:6379/0
# JUDGE_QUEUE_URL=redis://judge-queue:6379/0          # judge queue (ADR-0028) — api/worker/beat use it for judge jobs; session Redis stays REDIS_URL
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=rankwant
# S3_KEY=rankwant
# S3_SECRET=
# DJANGO_DEBUG=0                                      # public overlay; settings default is True
# CORS_ALLOWED_ORIGINS=                               # public overlay copies PUBLIC_ORIGIN
# CSRF_TRUSTED_ORIGINS=

# ── Read by the code, not passed by compose (defaults shown) ────────────
# DJANGO_ADMIN=                                       # defaults to DEBUG
# S3_REGION=us-east-1
# TRUSTED_CLIENT_IP_HEADER=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_FAIL_OPEN=1
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# JUDGE_PROVIDER=redis
# JUDGE_NET_PREFLIGHT=0                              # judge-go/py ADR-0028 network preflight gate; compose sets 1 together with judge-net (internal: true)
# JUDGE_FORBIDDEN_HOSTS=                             # extra host:port targets the judge must NOT reach, comma-separated (ADR-0028)
# POSTGRES_HOST=postgres                             # judge preflight default forbidden target
# POSTGRES_PORT=5432
# API_PORT=8000
# JUDGE_S3_SECRET=judge-ro-dev                       # MinIO judge-ro secret (ADR-0028); minio-init and judge get the SAME value; override in .env.public
# LOG_LEVEL=INFO
# EMAIL_TIMEOUT=10
# CELERY_EAGER=0                                      # tests and local gates set 1
# KEP_SITE=https://kep.uz
# KEP_API_BASE=https://kep.uz/api
# GUNICORN_WORKERS=4
# THROTTLE_ANON=1500/hour
# THROTTLE_ANON_INTERNAL=20000/hour
# THROTTLE_USER=300/min
# THROTTLE_SUBMIT=6/min
# THROTTLE_HACK=10/min
# THROTTLE_EXPORT=3/hour
# THROTTLE_PASSWORD_RESET=20/hour
# THROTTLE_REGISTER=40/hour
# THROTTLE_USERNAME_CHECK=120/hour
# THROTTLE_ACCOUNT_CHANGE=20/hour
# THROTTLE_AVATAR=30/hour
# THROTTLE_ANALYTICS=240/hour
# HACK_INPUT_MAX_BYTES=1048576
# HACK_GENERATOR_OUTPUT_KB=4096
# HACK_UPHACK_MIN_RATING=1900
# HACK_ROOM_SIZE=40
# API_BASE_INTERNAL=                                  # web, server side
# NEXT_PUBLIC_SITE_URL=https://rankwant.uz            # web, build time
# NEXT_PUBLIC_CUSTOMIZER=1                            # web, build time; 0 hides the theme customizer
# Feature flags (web, build time). Unset means "on" — see apps/web/src/lib/flags.ts
# for the full precedence order (query param > cookie > env > default). Set to 0
# to turn one off. They are read at build time, so changing one needs a rebuild.
# NEXT_PUBLIC_FLAG_NEW_NAV=                           # 0 restores the previous header
# NEXT_PUBLIC_FLAG_NEW_PALETTE=                       # 0 restores the previous palette
# NEXT_PUBLIC_FLAG_OPTIMISTIC_SAVE=                   # 0 disables optimistic saves
# NEXT_PUBLIC_FLAG_GEO_EARLY_REGION=                  # 0 stops the early country guess

# ── Kept in .env.public, read by nothing in this repository ─────────────
# CLOUDFLARE_API_TOKEN=                               # manual Cloudflare / wrangler work
