#!/usr/bin/env bash
# Push'dan oldingi darvoza.
#
# CI o'z mashinamizda (self-hosted runner) ishlaydi, ya'ni buzuq commit
# faqat GitHub'da emas, shu kompyuterda ham vaqt yeydi. Shuning uchun
# tekshiruvlar push'dan OLDIN, mahalliy muhitda o'tadi.
#
# Faqat o'zgargan qismlar ishlaydi: hujjat commit'i uchun hech narsa.
# Chetlab o'tish: git push --no-verify
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Interpretator NOMI bo'yicha emas, ISHGA TUSHISHI bo'yicha tanlanadi —
# to'liq sabab `tools/pick-python.sh` da. Qisqasi: Windows'da `python3`
# Microsoft Store'ning stub'iga tushadi, `command -v` uni topadi, lekin u
# ishga tushmaydi. 2026-09-15 da shu sabab to'rtta tekshiruv «yiqildi»
# deb ko'rsatildi, holbuki kod soz edi.
#
# Python topilmasa hook YO'QOLMAYDI: jim `exit 0` — «e'lon qilingan,
# lekin jonsiz» darvoza bo'lardi. Buning o'rniga ochiq xato beriladi.
if ! PY="$(bash "$root/tools/pick-python.sh")"; then
  printf '\n\033[31m✗ Ishlaydigan Python topilmadi — tekshiruvlar bajarilmadi.\033[0m\n' >&2
  printf "  Sababni ko'rish: bash tools/pick-python.sh\n" >&2
  printf '  Chetlab o'"'"'tish: git push --no-verify\n\n' >&2
  exit 1
fi

# Nimani tekshirish kerak — shu branch OLIB KELGAN fayllar.
#
# ⚠️ Ilgari `@{upstream}` bo'lmasa `range` jimgina `HEAD` ga tushardi.
# Toza daraxtda `git diff --name-only HEAD` BO'SH qaytaradi, ya'ni
# keyingi qator `exit 0` qilardi va HAR YANGI BRANCHNING BIRINCHI
# push'i umuman tekshirilmay o'tardi — darvoza e'lon qilingan, lekin
# jonsiz. Yangi branchda upstream hali yo'q, ya'ni bu nodir holat emas:
# aynan birinchi push shu yo'ldan o'tadi (2026-09-15 da o'lchandi).
#
# Upstream bo'lmasa asosiy branchdan boshlanadi. U ham topilmasa —
# «o'lchab bo'lmadi» holati: jim o'tkazib yuborish EMAS, hamma fayl
# olinadi va tekshiruvlar to'liq ishlaydi.
base="$(git rev-parse --verify --quiet '@{upstream}' || true)"
[ -n "$base" ] || base="$(git rev-parse --verify --quiet origin/main || true)"
if [ -n "$base" ]; then
  # Uch nuqta — umumiy ajdoddan beri: asosiy branchdagi begona
  # commit'lar bu branchning ishi deb hisoblanmaydi.
  files="$(git diff --name-only "$base...HEAD")"
else
  printf '\033[33m! Taqqoslash nuqtasi topilmadi — HAMMA fayl tekshiriladi.\033[0m\n' >&2
  files="$(git ls-files)"
fi

# `--print-files` — salbiy test uchun kirish nuqtasi: qaysi fayllar
# tanlanganini ko'rsatadi va tekshiruvlarni ISHLATMAYDI. Git hook'ni
# chaqirganda `$1` remote nomi bo'ladi, ya'ni bu bayroq faqat qo'lda
# chaqirilganda tushadi.
if [ "${1:-}" = "--print-files" ]; then
  printf '%s\n' "$files"
  exit 0
fi

# Which refs are pushed and under whose name (main only via PR, no placeholder
# authors) — rules and incidents in tools/push_guard.py. It runs before the
# gates so a rejected push does not wait for pytest, and before the empty-diff
# exit so a docs-only push to main is still caught.
if [ -t 0 ]; then refs=""; else refs="$(cat)"; fi
if ! printf '%s\n' "$refs" | "$PY" "$root/tools/push_guard.py" "${1:-origin}"; then
  printf '\n\033[31mPush to'\''xtatildi.\033[0m\n\n' >&2
  exit 1
fi

[ -z "$files" ] && exit 0

has() { grep -qE "$1" <<<"$files"; }
fail=0

schema_matches() {
  # ⚠️ `/tmp` ISHLATILMAYDI. Windows'da bu ikki xil joy: Git Bash `/tmp`
  # ni MSYS ildizi deb biladi, nativ Python esa `C:\tmp\` deb ochadi.
  # `spectacular` `exit 0` bilan `C:\tmp\` ga yozadi, biz Git Bash
  # tomonidagi BO'SH faylni taqqoslaymiz va `diff -q` «differ» deydi —
  # ya'ni har push'da yolg'on «sxema eskirgan» xatosi. O'lchandi
  # (2026-09-14): fayl 0 bayt, `spectacular_rc=0`.
  # Shuning uchun yo'l loyiha ichida va ANIQ bo'ladi — ikkala tomon ham
  # uni bir xil ochadi.
  local tmp=".tmp/schema_hook_check.yml" rc=1
  mkdir -p .tmp || return 1
  if uv run python manage.py spectacular --file "$tmp" >/dev/null 2>&1 &&
     [ -s "$tmp" ] &&
     diff -q openapi/schema.yml "$tmp" >/dev/null; then
    rc=0
  else
    # Bo'sh fayl «eskirgan sxema» degani EMAS — buni ajratib aytamiz,
    # aks holda keyingi odam sxemani behuda qayta yaratadi.
    if [ ! -s "$tmp" ]; then
      printf '  ✗ Sxema yaratilmadi (fayl bo`sh) — `spectacular` chiqishini ko`ring.\n'
    else
      printf '  Yangilang: cd apps/api && uv run python manage.py spectacular --file openapi/schema.yml\n'
    fi
  fi
  rm -f "$tmp"
  return "$rc"
}

step() {
  printf '\n\033[1m→ %s\033[0m\n' "$1"; shift
  if ! "$@"; then printf '\033[31m✗ yiqildi\033[0m\n'; fail=1; fi
}

if has '^apps/api/'; then
  cd apps/api
  step "API — ruff" uv run ruff check .
  step "API — format" uv run ruff format --check .
  step "API — mypy" uv run mypy .
  # `CELERY_EAGER=1` SHART. Usiz `core.tasks.queue()` har chaqiruvda
  # o'chiq Redis brokeriga uradi va Celery result backend ~109 s retry
  # qiladi — xato `except Exception` bilan yutiladi, ya'ni test YASHIL
  # qoladi va faqat vaqt ketadi. O'lchandi: 1191 test 14m54s → 1m57s.
  # Mahalliy ishga tushirishda Redis kerak emas (docs/10-operations/
  # test-strategy.md).
  step "API — pytest" env CELERY_EAGER=1 uv run pytest -q -n 4
  # CI dagi «OpenAPI schema diff» darvozasining nusxasi. Endpoint
  # qo'shilganda sxemani yangilash oson unutiladi va xato faqat CI da
  # chiqadi — ya'ni bir necha daqiqa keyin, boshqa commit ustiga.
  step "API — OpenAPI schema" schema_matches
  cd "$root"
fi

if has '^apps/web/'; then
  cd apps/web
  step "Web — eslint" npm run lint
  step "Web — typecheck" npm run typecheck
  step "Web — unit testlar" npm run test
  cd "$root"
  # Tiplar kalit yetishmasligini ushlaydi, lekin bo'sh satrni yoki
  # tarjimasiz qoldirilgan nusxani ko'rmaydi.
  step "Web — i18n to'liqligi" "$PY" tools/check_i18n.py
  # `t()` ning zaxira yo'li HAQIQIY modulda: dev'da otiladi, prod'da
  # bir marta jurnalga yoziladi. Statik tekshiruv buni ko'rmaydi.
  step "Web — i18n runtime" node tools/check_i18n_runtime.mjs
  # Tekshiruvlarning o'zi buzuq holatni tutishini talab qiladi.
  step "Tekshiruvlar — salbiy testlar" "$PY" tools/check_negative.py
  # 18 palitra × 4 pog'ona — ko'z bilan tekshirib bo'lmaydi.
  step "Web — matn kontrasti" "$PY" tools/check_contrast.py
fi

# Verdikt kodlari ikki joyda yashaydi (`apps/api/judging/verdicts.py` va
# `apps/web/src/lib/theme/verdict.ts`) va jimgina ajralib ketadi: bir marta
# 23 koddan 14 tasi web'da yo'q edi va «Navbatda» bo'lib ko'ringan. `tsc`
# ham, eslint ham buni tutmaydi — kalit oddiy `string`.
if has '^(apps/web/|apps/api/judging/)'; then
  step "Verdikt kodlari — API bilan moslik" "$PY" tools/check_verdict_codes.py
fi

# Ikonka registri (D12). Uch narsani ushlaydi: to'plamlardan birida kalit
# yetishmasligi (jimgina zaxira yo'q), qat'iy zonaning registrga tushishi
# (D20 ①), va `icon-keys.mjs` bilan generatsiya qilingan xaritalarning
# ajralib ketishi. Uchtasi ham `tsc` ga ko'rinmaydi — kalit oddiy `string`.
if has '^(apps/web/src/(icons|lib/theme)/|tools/(icon-keys|gen-icon-packs))'; then
  step "Ikonka registri — to'plamlar mosligi" "$PY" tools/check_icons.py
fi

# Markup'ni o'zgartiruvchi sozlama TO'RT joyda takrorlanadi: tip, parse,
# serialize va boot skript. Biri yangilanmasa — hidratsiya buziladi, va bu
# faqat brauzerda ko'rinadi (`tsc` ham, eslint ham jim). 2026-09-15 da
# aynan shu ikki marta bo'lgan.
if has '^(apps/web/src/(lib/(prefs\.ts|api/)|app/layout\.tsx)|tools/check_markup)'; then
  step "Markup cookie — 4 joy mosligi" "$PY" tools/check_markup_cookie.py
fi

# CI har yurishda yangi Docker obrazi quradi. Tozalash qadami olib
# tashlansa birorta test qizil bo'lmaydi — obrazlar haftalar ichida
# yig'ilib disk to'ldiradi (2026-09-16: 420 ta rw-smoke-*, 58 GB).
if has '^(\.github/workflows/|tools/check_ci_disk)'; then
  step "CI disk tozalashi" "$PY" tools/check_ci_disk.py
fi

if has '^(docs/|README)'; then
  step "Hujjat yaxlitligi" "$PY" tools/check_docs.py
fi

if has '^(apps/api/|tools/)'; then
  # DRF `ordering` da tiebreaker: `["-created_at"]` yakka o'zi SQL
  # tartibini beqaror qoldiradi. O'lchandi: `test_qidiruv_va_tartib`
  # 5 ishga tushirishning 1 tasida shu sabab bilan yiqilardi.
  step "DRF ordering tiebreaker" "$PY" tools/check_ordering.py
fi

if has '^(services/|apps/api/judging/)'; then
  step "Judge shartnomasi" "$PY" tools/check_contract.py
fi

# .env.example must document every variable compose and the code read.
if has '^(\.env\.example|docker-compose[^/]*\.yml|apps/api/|apps/web/src/|services/|tools/check_env_example\.py)'; then
  step ".env.example to'liqligi" "$PY" tools/check_env_example.py
fi

# Owner decisions (CLAUDE.md § Saidakbar aka qarorlari) must stay true in code.
if has '^(tools/(backup\.sh|push_guard\.py|check_decisions\.py)|\.githooks/|\.github/workflows/|CONTRIBUTING\.md|CLAUDE\.md)'; then
  step "Egasining qarorlari" "$PY" tools/check_decisions.py
fi

if [ "$fail" -ne 0 ]; then
  printf '\n\033[31mPush to'\''xtatildi.\033[0m Tuzating yoki: git push --no-verify\n\n'
  exit 1
fi

printf '\n\033[32m✓ Darvozalar o'\''tdi\033[0m\n\n'
